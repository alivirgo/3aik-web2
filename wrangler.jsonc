{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "3aik-web2",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
