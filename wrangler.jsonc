{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "3aik-web2",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "NUC7_STATS",
      "id": "0dd27f8bcc504a51b5c8bfde19db00d9"
    }
  ],
  "d1_databases": [
    {
      "binding": "AI_NEWS_DB",
      "database_name": "3aik-ai-news",
      // Placeholder. Replace after `npx wrangler d1 create 3aik-ai-news`. See docs/ai-news.md.
      "database_id": "11111111-1111-4111-8111-111111111111",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AI_NEWS_IMAGES",
      "bucket_name": "3aik-ai-news-images"
    }
  ],
  "triggers": {
    "crons": ["7 * * * *", "37 * * * *"]
  },
  "vars": {
    "AI_NEWS_ARTICLES_PER_HOUR": "1",
    "AI_NEWS_PUBLISHING": "off",
    "AI_NEWS_SITE_ORIGIN": "https://3aik.com",
    "AI_NEWS_TEXT_CALLS_PER_ARTICLE": "6",
    "AI_NEWS_IMAGE_CALLS_PER_ARTICLE": "2",
    "AI_NEWS_MAX_FAILURES": "2",
    "AI_NEWS_REJECT_TTL_HOURS": "24",
    "AI_NEWS_WALL_MS": "45000",
    "AI_NEWS_TEXT_TIMEOUT_MS": "15000",
    "AI_NEWS_IMAGE_TIMEOUT_MS": "20000",
    "AI_NEWS_RETENTION_DAYS": "180"
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "3101",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "IMAGE_RATE_LIMITER",
      "namespace_id": "3102",
      "simple": { "limit": 2, "period": 60 }
    },
    {
      "name": "AGENT_RATE_LIMITER",
      "namespace_id": "3103",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
