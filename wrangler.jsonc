{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "3aik-web2",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "NUC7_STATS",
      "id": "0dd27f8bcc504a51b5c8bfde19db00d9"
    }
  ],
  "d1_databases": [
    {
      "binding": "AI_NEWS_DB",
      "database_name": "3aik-ai-news",
      "database_id": "87a550eb-1752-4cec-8c20-dd6b839099e2",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["7 * * * *", "37 * * * *"]
  },
  "vars": {
    "AI_NEWS_ARTICLES_PER_HOUR": "1",
    "AI_NEWS_PUBLISHING": "on",
    "AI_NEWS_GENERATOR": "off",
    "AI_NEWS_SITE_ORIGIN": "https://3aik.com",
    "AI_NEWS_TEXT_CALLS_PER_ARTICLE": "6",
    "AI_NEWS_IMAGE_CALLS_PER_ARTICLE": "2",
    "AI_NEWS_MAX_FAILURES": "2",
    "AI_NEWS_REJECT_TTL_HOURS": "24",
    "AI_NEWS_WALL_MS": "300000",
    "AI_NEWS_TEXT_TIMEOUT_MS": "60000",
    "AI_NEWS_IMAGE_TIMEOUT_MS": "20000",
    "AI_NEWS_RETENTION_DAYS": "180",
    "AI_NEWS_STATS_ENABLED": "true"
    // AI_NEWS_CONTACT_EMAIL is optional. Set a real address in the dashboard when one exists. Leave it unset until then.
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "3101",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "IMAGE_RATE_LIMITER",
      "namespace_id": "3102",
      "simple": { "limit": 2, "period": 60 }
    },
    {
      "name": "AGENT_RATE_LIMITER",
      "namespace_id": "3103",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "NEWS_STATS_RATE_LIMITER",
      "namespace_id": "3104",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEWS_STATS_BUDGET",
        "class_name": "NewsStatsBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-news-stats-budget",
      "new_sqlite_classes": ["NewsStatsBudget"]
    }
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
