{
  "name": "3aik-web2",
  "version": "2.0.0",
  "description": "A local-first AI workspace on Cloudflare Workers",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "lint:client": "node --check public/chat.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint:client && npm test && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260816.1",
    "@types/node": "26.2.0",
    "happy-dom": "^20.11.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  }
}
